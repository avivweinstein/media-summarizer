[Unit]
Description=Media Summarizer — personal media intelligence pipeline
After=network.target

[Service]
Type=simple
User=aviv
WorkingDirectory=/home/aviv/Github/media-summarizer
ExecStart=/home/aviv/Github/media-summarizer/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=media-summarizer

# Load environment variables from .env
EnvironmentFile=/home/aviv/Github/media-summarizer/.env

[Install]
WantedBy=multi-user.target
