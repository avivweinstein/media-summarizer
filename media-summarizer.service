[Unit]
Description=Media Summarizer — personal media intelligence pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/aviv/Github/media-summarizer
ExecStart=/home/aviv/Github/media-summarizer/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=media-summarizer
EnvironmentFile=/home/aviv/Github/media-summarizer/.env

[Install]
WantedBy=default.target
