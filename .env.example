# ── AI APIs ──────────────────────────────────────────────────────────────────
# Anthropic — used for Claude summarization
# Get at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — used for Whisper podcast transcription
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Obsidian ──────────────────────────────────────────────────────────────────
# Local Obsidian vault used as the canonical archive. Leave blank to disable.
OBSIDIAN_VAULT_PATH=

# Store the full transcript as a separate Markdown note.
OBSIDIAN_RETAIN_TRANSCRIPT=true

# ── Notion ────────────────────────────────────────────────────────────────────
# Optional secondary destination. When Obsidian succeeds, Notion failures do not
# fail the job.
NOTION_ENABLED=false

# Integration token — "Internal Integration" at https://www.notion.so/my-integrations
# Must be connected to both databases below (Share → Invite your integration)
NOTION_API_KEY=

# Your main Media Summarizer database — copy the ID from the database URL:
# https://notion.so/yourworkspace/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=

# A separate Notion database used only for integration tests (keeps test pages
# out of your real database). Create a blank database, connect the integration,
# and paste its ID here. Also add this value as a GitHub Actions secret.
NOTION_TEST_DATABASE_ID=

# ── YouTube ───────────────────────────────────────────────────────────────────
# YouTube Data API v3 key — used for video metadata (title, channel, duration)
# Get at: https://console.cloud.google.com → APIs & Services → Credentials
# Enable "YouTube Data API v3" first.
YOUTUBE_API_KEY=

# ── OpenClaw (WhatsApp) ───────────────────────────────────────────────────────
# Webhook URL that OpenClaw exposes for receiving results back.
# Format depends on your OpenClaw setup (e.g. http://localhost:PORT/openclaw/webhook)
# Leave blank if not using WhatsApp integration.
OPENCLAW_WEBHOOK_URL=

# ── Per-job reliability and spend limits ─────────────────────────────────────
SUMMARY_CHUNK_CHARS=60000
MAX_TRANSCRIPT_CHARS=600000
MAX_ANTHROPIC_REQUESTS_PER_JOB=12
MAX_OPENAI_REQUESTS_PER_JOB=3
MAX_AUDIO_DURATION_SECONDS=14400
MAX_AUDIO_DOWNLOAD_BYTES=500000000
MAX_ESTIMATED_COST_USD=2.0

# Cost-estimate rates for the pinned API models; update if provider pricing changes.
ANTHROPIC_INPUT_COST_PER_MILLION_USD=3.0
ANTHROPIC_OUTPUT_COST_PER_MILLION_USD=15.0
WHISPER_COST_PER_MINUTE_USD=0.006

# ── Podcast Index (unused — reserved for future) ──────────────────────────────
# Not currently required. Apple Podcasts use iTunes Lookup (free, no key).
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
